# Server Environment Variables
GROQ_API_KEY=your_key_here
PORT=3001
NODE_ENV=development

# Add-on Layer Feature Flags (default: false)
ADDON_AUTH=true
ADDON_EMPHASIS=true
ADDON_ALERTS=true
JWT_SECRET=signify-ai-addons-secret-key-2026

# Client Feature Flags (matching VITE_ prefix for client side access)
VITE_ADDON_AUTH=true
VITE_ADDON_EMPHASIS=true
VITE_ADDON_ALERTS=true
